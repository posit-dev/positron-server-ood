#!/usr/bin/env bash
<%-
working_dir = Pathname.new(context.working_dir.to_s)
working_dir = Pathname.new(ENV['HOME']) unless working_dir.exist?
working_dir = working_dir.parent if working_dir.file?
-%>
echo "TIMING - Starting main script at: $(date)"
echo "$(date): Running on $(hostname):${port}"

<%- unless context.positron_module.blank? -%>
module load <%= context.positron_module %>
<%- end -%>
<%- unless context.positron_server_dir.blank? -%>
export PATH="<%= context.positron_server_dir %>/bin:${PATH}"
export APPTAINERENV_PREPEND_PATH="<%= context.positron_server_dir %>/bin"
<%- end -%>

POSITRON_ARGS=(
  --host "0.0.0.0"
  --port "${port}"
  --connection-token-file "${POSITRON_CONNECTION_TOKEN_FILE}"
  --accept-server-license-terms
  --telemetry-level off
  --disable-workspace-trust
  --default-folder "<%= working_dir %>"
)

echo "TIMING - Starting positron-server at: $(date)"
<%- if context.apptainer_image.blank? -%>
exec positron-server "${POSITRON_ARGS[@]}"
<%- else -%>
BINDS="${PWD}"
[[ -n "${TMPDIR:-}" ]] && BINDS+=",${TMPDIR}"
<%- unless context.apptainer_binds.blank? -%>
BINDS+=",<%= context.apptainer_binds %>"
<%- end -%>
exec apptainer exec <%= '--nv ' if context.num_gpus.to_i > 0 %>--bind "${BINDS}" \
  "<%= context.apptainer_image %>" positron-server "${POSITRON_ARGS[@]}"
<%- end -%>
