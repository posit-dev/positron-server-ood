# Export the module function if it exists
[[ $(type -t module) == "function" ]] && export -f module

# Find available port to run server on
export port=$(find_port ${host})

# Positron Server reads the connection token from a file. The Connect button
# sends the same value as the tkn query parameter.
password="$(create_passwd 32)"
export POSITRON_CONNECTION_TOKEN_FILE="${PWD}/connection-token"
(umask 077; echo "${password}" > "${POSITRON_CONNECTION_TOKEN_FILE}")
